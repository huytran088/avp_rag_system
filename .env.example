# --- LLM routing ---
# Primary = local vLLM on the GPU box (cec-cap-gpu1); fallback = hosted API.
# To switch the fallback to an open model later, point the OpenAI-compatible
# vars at OpenRouter (https://openrouter.ai/qwen/qwen3.6-27b) and set the
# fallback provider to "vllm" against that base_url, or add a dedicated entry.
LLM_PROVIDER=vllm
LLM_FALLBACK_PROVIDER=anthropic

# --- Local vLLM (primary): Qwen3.6-27B AWQ INT4 on cec-cap-gpu1 ---
# FastAPI runs on :8000, vLLM on :8001 (same host, internal only).
# VLLM_MODEL must match vLLM's --served-model-name.
VLLM_BASE_URL=http://localhost:8001/v1
VLLM_MODEL=qwen3.6-27b-awq
VLLM_API_KEY=EMPTY
# Thinking off by default for clean code output; flip to true to keep the
# <think> reasoning trace (e.g. if the web app wants to show explanations).
VLLM_ENABLE_THINKING=false
# Qwen3.6 "precise coding" sampling defaults.
VLLM_TEMPERATURE=0.6
VLLM_TOP_P=0.95
VLLM_TOP_K=20
VLLM_MAX_TOKENS=1024

# --- Hosted, cheap (used by the HF Space backend: LLM_PROVIDER=hf, LLM_FALLBACK_PROVIDER=gemini) ---
# HF Inference Providers router (OpenAI-compatible). Billed to HF_TOKEN's account.
# Append ":cheapest" or ":fastest" to let the router pick the provider.
HF_TOKEN=hf_your-token-here
HF_MODEL=Qwen/Qwen3-Coder-30B-A3B-Instruct:cheapest
# Alternatives: zai-org/GLM-5.3-Flash:cheapest, Qwen/Qwen3-235B-A22B-Instruct-2507:cheapest
# Google Gemini via its OpenAI-compatible endpoint (key from https://aistudio.google.com/apikey)
GEMINI_API_KEY=your-gemini-key-here
GEMINI_MODEL=gemini-flash-lite-latest
# Shared sampling for hf/gemini
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0.6

# --- Anthropic (fallback) ---
ANTHROPIC_API_KEY=your-key-here
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Rate limit client key: x-real-ip (capstone nginx), x-forwarded-for (HF Spaces,
# set in Dockerfile) or peer. Only trust a header your proxy sets.
RATE_LIMIT_IP_SOURCE=x-real-ip
# With x-forwarded-for: entry to use, counted from the right
FORWARDED_TRUSTED_HOPS=1

# CORS: comma-separated origins for deployed frontends
CORS_ORIGINS=https://avp.capstone.csi.miamioh.edu


